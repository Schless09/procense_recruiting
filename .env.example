# Copy this file to .env and fill in real values. .env is gitignored.

# Procense's Ashby workspace (Ashby > Admin > API Keys)
ASHBY_API_KEY=

# Aimfox key for Procense outreach
AIMFOX_API_KEY=

# Notion integration (shared across clients)
NOTION_API_KEY=
# Procense-specific Notion pages/databases, so scripts never touch other clients' pages
NOTION_PROCENSE_ROOT_PAGE_ID=
NOTION_PROCENSE_CANDIDATES_DB_ID=
